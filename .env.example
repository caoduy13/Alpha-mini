# Copy to .env and fill in values.

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# Robot (LAN)
# ROBOT_ENABLED=true
# ROBOT_IP=192.168.1.100
# Tự quét LAN (mini_sdk.get_device_list) — không cần đọc IP trên mắt robot; ROBOT_IP vẫn là dự phòng khi quét trống.
# ROBOT_AUTO_DISCOVER=true
# Ghi IP vừa kết nối OK vào .env (ROBOT_IP) để DHCP đổi IP vẫn bám được sau restart.
# ROBOT_PERSIST_DISCOVERED_IP=true
# Thời gian quét LAN (giây)
# ROBOT_DISCOVER_TIMEOUT_SEC=8
# Chỉ chọn thiết bị có tên chứa chuỗi (vd. tên robot trong app) — khi có nhiều máy UBTECH trên LAN.
# ROBOT_DISCOVER_NAME_SUBSTR=mini
#
# ── Cùng Wi‑Fi với robot (bắt buộc cho WebSocket SDK + TTS/MP3 qua LAN) ──
# - Robot hotspot (vd. S23, IP robot 10.204.251.x): PC phải bật Wi‑Fi vào ĐÚNG hotspot đó — không test robot
#   khi PC vẫn đang LAN khác (vd. 192.168.11.x) vì ping/WS sẽ fail.
# - Trên PC: ipconfig → IPv4 của Wi‑Fi đó phải cùng dải với robot (vd. PC 10.204.251.y, robot 10.204.251.163).
# - ping <ROBOT_IP> phải có reply thì server mới kết nối WS (robot_online=true).
# - ROBOT_AUDIO_PUBLIC_URL = https:// hoặc http:// + IPv4 PC TRÊN CÙNG mạng với robot + :SERVER_PORT
#   (vd. https://10.204.251.5:8000 nếu server HTTPS). Sau khi đổi Wi‑Fi: .\sync-lan-env.ps1 rồi restart server.
# - Khi ping OK: POST /robot/reconnect hoặc restart start-server.ps1 → GET /status kiểm tra robot_online.
# - Ping OK mà WS vẫn timeout: thử ROBOT_TYPE=edu (firmware quốc tế); robot bật chế độ dev/app UBTECH; firewall cổng 9090.
#
# Chat → robot (ngồi, nhảy, …): server dùng từ khóa trước (không tốn thêm API).
# Bật dòng dưới nếu câu thường không khớp keyword — Gemini phân lớp intent (tốn thêm gọi model).
# ROBOT_SMART_INTENT=false
#
# OpenClaw: gõ trong UI Chat không tự gửi tới Alpha Mini — cần file bridge (OPENCLAW_FILE_BRIDGE_*)
# ghi ~/.openclaw/workspace/.alphamini_pending_chat.txt hoặc skill/tool gọi POST /chat (xem alphamini-openclaw.ps1).

# ── Tối thiểu: FPT TTS → MP3 trên PC → robot play_online_audio ──
# Robot tải file qua URL LAN; KHÔNG dùng 127.0.0.1. Cổng = SERVER_PORT (mặc định 8000).
# ROBOT_TTS_MODE=prefer_http
# ROBOT_AUDIO_PUBLIC_URL=http://192.168.1.5:8000
# FPT_AI_TTS_API_KEY=
# Đừng để ROBOT_TTS_HTTP_ENGINE=edge — xóa dòng đó, hoặc để trống (có key FPT → auto fpt), hoặc =fpt

# TTS sau mỗi câu trả lời (SDK StartPlayTTS, best-effort trên firmware)
ROBOT_SPEAK_REPLIES=true
# Bật TTS kể cả khi client gửi speak=false nếu người dùng viết kiểu "đọc cho mình nghe"
ROBOT_SPEAK_FROM_PHRASES=true

# Tăng volume trước khi phát TTS (giúp debug trường hợp SDK ok=True nhưng không nghe)
ROBOT_SET_VOLUME_BEFORE_TTS=true
ROBOT_TTS_VOLUME=1.0

# Khi StartPlayTTS không ra tiếng: tổng hợp MP3 trên PC rồi robot phát qua play_online_audio.
#   sdk         — chỉ SDK nội bộ
#   http_only   — chỉ MP3 + URL (cần ROBOT_AUDIO_PUBLIC_URL)
#   prefer_http — thử MP3 trước, lỗi thì SDK
# ROBOT_TTS_MODE=prefer_http
# URL mà robot mở được tới máy bạn (IP LAN của PC, cổng server), ví dụ:
# ROBOT_AUDIO_PUBLIC_URL=http://192.168.0.5:8000
# Auto-detect: leave ROBOT_AUDIO_PUBLIC_URL blank/commented → server detects LAN IP at startup.
# Manual override: set ROBOT_AUDIO_PUBLIC_URL=http://<your-pc-ip>:<SERVER_PORT>
# Use manual override only if auto-detect picks the wrong network interface (e.g. VPN, WSL).
# Engine: edge | fpt (FPT.AI) | google — để trống → có FPT_AI_TTS_API_KEY thì dùng fpt, không thì edge
# ROBOT_TTS_HTTP_ENGINE=
#
# FPT.AI TTS v5 (console: POST https://api.fpt.ai/hmi/tts/v5, header api-key, voice minhquang, speed 0)
# FPT_AI_TTS_API_KEY=
# FPT_AI_TTS_VOICE=minhquang
# FPT_AI_TTS_SPEED=0
# FPT_AI_TTS_API_HEADER=api-key
#
# Google: pip google-cloud-texttospeech + GOOGLE_APPLICATION_CREDENTIALS
# Hai giọng tiếng Việt Edge: vi-VN-HoaiMyNeural | vi-VN-NamMinhNeural
# EDGE_TTS_VOICE=vi-VN-HoaiMyNeural
# Gợi ý “nam, gần trẻ, nói vừa”: NamMinh + pitch cao (Edge không có giọng bé VN)
# EDGE_TTS_VOICE=vi-VN-NamMinhNeural
# EDGE_TTS_RATE=-2%
# EDGE_TTS_PITCH=+12Hz
# Đọc chậm hơn ~10% thường tự nhiên hơn (Edge: -20% tới +20%)
# EDGE_TTS_RATE=-10%
# EDGE_TTS_PITCH=+0Hz
# EDGE_TTS_VOLUME=+0%
#
# Giọng tự nhiên hơn nữa: ROBOT_TTS_HTTP_ENGINE=google + pip google-cloud-texttospeech + JSON service account
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\key.json
# GOOGLE_TTS_VOICE_NAME=vi-VN-Neural2-A

# Server
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000
# CORS: OpenClaw Control UI (mặc định gồm 127.0.0.1 + localhost, http + https :18789; gateway local thường http://)
# CORS_ALLOW_ORIGINS=https://127.0.0.1:18789,https://localhost:18789,http://127.0.0.1:18789,http://localhost:18789

# Ảnh chụp từ camera robot (TakePicture): auto = bytes trong response SDK trước, rồi HTTP picPath | sdk_only | http_only
# ROBOT_IMAGE_FETCH_MODE=auto
#
# Ảnh qua HTTP (fallback khi SDK không trả bytes): server GET từ ROBOT_IP
# Bắt buộc đúng cổng/path nếu không sẽ 502 (xem log urls_tried). Chẩn đoán: .\diagnose-robot-http.ps1
# ROBOT_FILE_HTTP_PORTS=8080,8888,80
# Nếu biết URL đúng trên firmware (khuyến nghị khi mặc định không tải được):
# ROBOT_IMAGE_URL_TEMPLATE=http://{ip}:8080{path}
#
# Preview /robot/camera/frame — khoảng cách tối thiểu giữa hai lần chụp SDK (giây).
# Mặc định trong code: 1.25 (sàn server 0.5). Tăng nếu robot bị treo/timeout khi mở panel camera.
# ROBOT_CAMERA_POLL_MIN_SEC=1.25
# Khi take_picture báo code=-2: tự enter_program() rồi chụp lại (một lần sau mỗi lần kết nối thành công)
# ROBOT_TAKE_PICTURE_RETRY_ENTER_PROGRAM=true
# Thử chế độ FINDFACE nếu IMMEDIATELY lỗi (cần mặt trước camera)
# ROBOT_TAKE_PICTURE_TRY_FINDFACE=false
# HTTPS (truy cập từ điện thoại qua https://IP:port — cần chứng chỉ dev, không dùng http://+IP cho một số trình duyệt)
# Tạo chứng chỉ: .\gen-dev-ssl.ps1 -LanIp 192.168.1.5
# (đặt IP = IP LAN của máy chạy server). File mặc định: ssl/server.crt + ssl/server.key
# SERVER_SSL_CERTFILE=ssl/server.crt
# SERVER_SSL_KEYFILE=ssl/server.key
# Sau khi bật HTTPS, robot/TTS URL nên dùng https:
# ROBOT_AUDIO_PUBLIC_URL=https://192.168.1.5:8000

# ── OpenClaw skill (optional HTTP auth) ──
# Token cho client gọi POST /chat, GET /robot/trigger, POST /robot/reconnect.
# Trống = không enforce (dev). Set = bắt buộc header X-Alphamini-Token khớp giá trị này.
# Sinh: openssl rand -hex 32  hoặc PowerShell: [guid]::NewGuid().ToString("N")
# ALPHAMINI_SKILL_TOKEN=
