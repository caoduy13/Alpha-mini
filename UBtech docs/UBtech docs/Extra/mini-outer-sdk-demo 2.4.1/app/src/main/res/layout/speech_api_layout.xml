<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="========= 国内语音服务接口  ============" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="subscribeWakeupEvent"
            android:text="订阅唤醒事件" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="subscribeWakeupAngelEvent"
            android:text="订阅唤醒角度事件" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="subscribeAsrStateEvent"
            android:text="订阅ASR状态事件" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="subscribeInitResultEvent"
            android:text="订阅初始化事件" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="unsubscribeEvent"
            android:text="取消事件订阅" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="========= 国外语音服务接口  ==========" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="oSubscribeWakeupEvent"
            android:text="订阅唤醒事件" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="oSubscribeWakeupAngelEvent"
            android:text="订阅唤醒角度事件" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="oSubscribeAsrStateEvent"
            android:text="订阅ASR状态事件" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="oSubscribeInitResultEvent"
            android:text="订阅初始化事件" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="oUnsubscribeEvent"
            android:text="取消事件订阅" />


    </LinearLayout>

</ScrollView>